{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch: wordset-service",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: wordset-service",
            "program": "${workspaceFolder}/backend/wordset-service/Wordset.API/bin/Debug/net10.0/Wordset.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/wordset-service/Wordset.API",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": "Attach: wordset-service",
            "type": "coreclr",
            "request": "attach",
            "processName": "Wordset.API"
        }
    ]
}
