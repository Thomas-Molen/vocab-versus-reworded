{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: wordset-service",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/backend/wordset-service/Wordset.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch: wordset-service",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "${workspaceFolder}/backend/wordset-service/Wordset.API/Wordset.API.csproj"
            ],
            "group": "build",
            "isBackground": true,
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
